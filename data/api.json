          "required": false,
          "description": "answers to a previous needs_information response, keyed by its question `field`"
        },
        {
          "name": "use_llm",
          "type": "object",
          "required": false,
          "description": "when no capability matches, let the configured model write the closest case instead of the deterministic planner; null uses the server default (BEST_EFFORT_LLM)"
