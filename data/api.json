          "source": "curl -s -X POST https://engineering.pinneapple.org/v1/jobs -H \"X-API-Key: $PEA_KEY\" -H 'Content-Type: application/json' \\\n  -d '{\"capability_id\": \"preset.plate_fin_heatsink_forced\", \"params\": {\"power\": 60, \"velocity\": 3}}'"
